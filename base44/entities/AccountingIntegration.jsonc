{
  "name": "AccountingIntegration",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID"
    },
    "provider": {
      "type": "string",
      "enum": [
        "MORNING",
        "GREEN_INVOICE",
        "QUICKBOOKS",
        "ZOHO_BOOKS",
        "XERO",
        "HASHAVSHEVET"
      ],
      "description": "Accounting provider"
    },
    "name": {
      "type": "string",
      "description": "Integration name"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "INACTIVE",
        "ERROR"
      ],
      "default": "INACTIVE",
      "description": "Connection status"
    },
    "config": {
      "type": "object",
      "description": "Provider-specific configuration (encrypted)"
    },
    "auto_sync": {
      "type": "boolean",
      "default": true,
      "description": "Auto sync invoices and receipts"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last sync timestamp"
    },
    "error_message": {
      "type": "string",
      "description": "Last error message if any"
    }
  },
  "required": [
    "org_id",
    "provider",
    "name"
  ]
}