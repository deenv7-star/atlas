{
  "name": "MessageLog",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID"
    },
    "booking_id": {
      "type": "string",
      "description": "Booking ID"
    },
    "channel": {
      "type": "string",
      "enum": [
        "WHATSAPP",
        "SMS",
        "EMAIL"
      ],
      "description": "Message channel"
    },
    "to_contact": {
      "type": "string",
      "description": "Recipient contact"
    },
    "template_id": {
      "type": "string",
      "description": "Template ID (optional)"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "SENT",
        "FAILED"
      ],
      "default": "DRAFT",
      "description": "Message status"
    },
    "body_text": {
      "type": "string",
      "description": "Message body"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Sent timestamp"
    }
  },
  "required": [
    "org_id",
    "booking_id",
    "channel",
    "to_contact",
    "body_text"
  ]
}