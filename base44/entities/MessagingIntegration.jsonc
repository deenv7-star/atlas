{
  "name": "MessagingIntegration",
  "type": "object",
  "properties": {
    "org_id": {
      "type": "string",
      "description": "Organization ID"
    },
    "provider": {
      "type": "string",
      "enum": [
        "WHATSAPP",
        "EMAIL_SMTP",
        "SMS_TWILIO",
        "TELEGRAM",
        "SENDGRID"
      ],
      "description": "Messaging provider type"
    },
    "name": {
      "type": "string",
      "description": "Integration name"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "INACTIVE",
        "ERROR"
      ],
      "default": "INACTIVE",
      "description": "Connection status"
    },
    "config": {
      "type": "object",
      "description": "Provider-specific configuration (encrypted)"
    },
    "last_test_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last connection test timestamp"
    },
    "error_message": {
      "type": "string",
      "description": "Last error message if any"
    }
  },
  "required": [
    "org_id",
    "provider",
    "name"
  ]
}