{
  "redirects": [
    {
      "source": "/how-it-works",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/how-it-works/",
      "destination": "/",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/manifest.webmanifest",
      "destination": "/manifest.json"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug/index.html"
    },
    {
      "source": "/:page(about|contact|privacy|terms|cookies|cancellation|data-processing|data-security|accessibility)",
      "destination": "/:page/index.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/:page(pricing|register|login)",
      "destination": "/:page/index.html"
    },
    {
      "source": "/:seg(AIAssistant|Automations|Billing|BookingDetail|Bookings|Cleaning|Contracts|Dashboard|DynamicPricing|ExpenseTracker|GuestJourney|GuestPortal|GuestService|HowItWorks|Integrations|Invoices|Landing|LeadDetail|Leads|Legal|Login|Messages|MultiCalendar|Onboarding|OwnerReports|Payments|PlatformAdmin|Pricing|PricingPlans|Register|RevenueIntelligence|Reviews|Security|ServiceRequests|Settings|Subscription|admin|ai-assistant|api-docs|auth|automations|balances|billing|book|booking|bookings|calendar|changelog|cleaning|contracts|dashboard|dev|dynamic-pricing|expense-tracker|g|guest-journey|guest-portal|guest-service|how-it-works|integrations|invoices|lead|leads|legal|messages|monthly-report|onboarding|owner-reports|payments|platform-admin|reset-password|revenue-intelligence|reviews|security|service-requests|settings|setup|sla|status|subscription|today|update-password|verify-email)/:rest*",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(landing-hero|landing-v6|landing-v7|landing-v8|demo|blog/covers|og)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/tour/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/llms(.*).txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(icons/.*|favicon.ico|favicon.svg|favicon-16x16.png|favicon-32x32.png|apple-touch-icon.png|og-image.png|atlas-logo.png|atlas-logo.svg|atlas-logo-clean.png|atlas-logo-final.png|atlas-logo-transparent.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/:file(manifest.json|manifest.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    },
    {
      "source": "/:file(sw.js|registerSW.js|sw-cleanup.js|push-sw.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/:page(reset-password|update-password|verify-email|onboarding|setup|auth)/:rest*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/.well-known/security.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
